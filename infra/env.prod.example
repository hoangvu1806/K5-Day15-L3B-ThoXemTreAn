# Sao chép thành infra/.env.prod và điền giá trị thật (KHÔNG commit .env.prod)

# Domain thật của VPS (để localhost khi test trên máy cá nhân)
DOMAIN=canthansaulungkiabeiu.site
TLS_EMAIL=admin@canthansaulungkiabeiu.site

# Cấu hình Nginx: để default.conf.template (chỉ HTTP) cho lần đầu lấy chứng chỉ,
# có chứng chỉ rồi thì đổi thành https.conf.example
NGINX_SITE=default.conf.template

# Để trống khi chạy Frontend & API chung domain qua Nginx (tránh CORS)
NEXT_PUBLIC_API_URL=

# Domain được phép gọi API (CORS), cách nhau bằng dấu phẩy. Để trống thì server chỉ cho localhost dev,
# KHÔNG mở "*". Chạy chung domain qua Nginx (NEXT_PUBLIC_API_URL để trống ở trên) thì cũng để trống luôn.
CORS_ORIGINS=https://canthansaulungkiabeiu.site,https://www.canthansaulungkiabeiu.site

# Model AI (OpenRouter) — nhớ đặt hạn mức chi tiêu trên OpenRouter Dashboard
MODEL_PROVIDER=openrouter
MODEL_NAME=openai/gpt-6-luna
API_KEY=sk-or-v1-replace-me
MODEL_TEMPERATURE=0.3

# An toàn & chống spam
SAFE_MODE=0
GROWSAFE_SHOW_DRAFT_SCENES=0
GROWSAFE_AI_RATE_LIMIT=30

# Quy mô API (giữ 1/1 ở Pha 0; nâng API_REPLICAS=2..4 sau khi hoàn thành Pha 1 Redis + contextvars)
API_REPLICAS=1
UVICORN_WORKERS=1

# PostgreSQL (chỉ dùng khi bật --profile scale)
POSTGRES_DB=growsafe
POSTGRES_USER=growsafe
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=

# Grafana (chỉ dùng khi bật --profile obs, truy cập qua SSH tunnel 127.0.0.1:3001)
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-strong-grafana-password
