# syntax=docker/dockerfile:1.7
# Multi-stage build gọn nhẹ cho GrowSafe AI Backend (FastAPI + Google ADK + LiteLLM + ffmpeg TTS)

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

WORKDIR /build
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY requirements.txt .
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache -r requirements.txt


FROM python:3.12-slim AS runtime

# Chỉ cài ffmpeg gọn nhất cho chuyển WAV -> MP3 ở codebase/tts.py, không cài gói thừa
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin growsafe

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=growsafe:growsafe codebase/ ./codebase/
COPY --chown=growsafe:growsafe data/ ./data/

RUN mkdir -p /var/lib/growsafe \
    && chown -R growsafe:growsafe /var/lib/growsafe

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PORT=6161 \
    GROWSAFE_DB=/var/lib/growsafe/growsafe.db \
    GROWSAFE_TTS_CACHE=/var/lib/growsafe/tts \
    UVICORN_WORKERS=1 \
    FORWARDED_ALLOW_IPS=172.28.0.0/16

USER growsafe
EXPOSE 6161

HEALTHCHECK --interval=20s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6161/health', timeout=3)" || exit 1

# Chỉ tin X-Forwarded-For từ mạng nội bộ của compose (nơi Nginx đứng), không tin '*'
CMD ["sh", "-c", "exec uvicorn server:app --app-dir codebase --host 0.0.0.0 --port ${PORT:-6161} --workers ${UVICORN_WORKERS:-1} --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS}\" --no-access-log"]
