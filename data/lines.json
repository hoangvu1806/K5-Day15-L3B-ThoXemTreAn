    "rule": [
      {
        "id": "rule_R01_1115",
        "text": "Vùng đồ bơi là riêng tư. Vùng kín là của riêng bạn. Dù là ai, cũng không được nhìn, chạm hay chụp ảnh nếu bạn chưa đồng ý.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R01_610",
        "text": "Vùng đồ bơi là riêng tư. Vùng đồ bơi che là của riêng cậu thôi, không ai được nhìn hay chạm vào đó cả.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R02_1115",
        "text": "Cơ thể của mình là của mình. Bạn có quyền từ chối cái chạm làm mình khó chịu, kể cả từ người thân. Ai thật lòng tôn trọng bạn sẽ dừng lại ngay.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R02_610",
        "text": "Cơ thể của mình là của mình. Không thích ôm hay thơm thì cậu cứ nói không, vẫy tay chào thay cũng được mà.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R03_1115",
        "text": "Bí mật tốt, bí mật xấu. Ai dặn bạn giấu bố mẹ, nhất là kèm quà hay lời dọa, đó là dấu hiệu nguy hiểm đấy. Kể ngay đi.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R03_610",
        "text": "Bí mật tốt, bí mật xấu. Bí mật nào làm cậu thấy sợ hay khó chịu thì đó là bí mật xấu, cứ kể cho bố mẹ nghe.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R04_1115",
        "text": "Ba bước: không, đi, kể. Nói không, rời đi hoặc chặn, rồi kể với người lớn bạn tin. Làm được bước nào cũng đáng khen cả.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R04_610",
        "text": "Ba bước: không, đi, kể. Ba bước nhớ nhé: nói không, chạy đi, rồi kể lại cho người lớn mình tin.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R05_1115",
        "text": "Người lớn tin cậy. Chọn sẵn vài người lớn bạn tin, ở nhà lẫn ở trường. Người đầu chưa giúp được thì kể tiếp người khác, đừng bỏ cuộc.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R05_610",
        "text": "Người lớn tin cậy. Cậu nghĩ sẵn trong đầu hai người lớn mình tìm được nhé. Người này chưa giúp thì mình kể người khác.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R06_1115",
        "text": "Gọi đúng tên. Gọi đúng tên bộ phận cơ thể giúp bạn kể lại rõ ràng hơn, lúc cần người khác giúp.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R06_610",
        "text": "Gọi đúng tên. Chỗ đồ bơi che gọi là vùng kín đó. Nói đúng tên vậy không có gì xấu hổ cả.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R07_1115",
        "text": "Không đi theo người lạ. Đừng lên xe hay đi theo người bạn không quen, dù họ nói lý do gì. Gọi bố mẹ hỏi lại cho chắc trước đã.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R07_610",
        "text": "Không đi theo người lạ. Người lạ nói mẹ nhờ đón cũng mặc kệ, cậu không đi đâu. Ở lại tìm cô giáo hay bác bảo vệ.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R08_1115",
        "text": "An toàn trên mạng. Đừng gửi ảnh riêng tư cho bất kỳ ai. Chặn, chụp màn hình giữ lại làm bằng chứng, rồi kể cho người lớn bạn tin.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R08_610",
        "text": "An toàn trên mạng. Trên mạng có ai xin ảnh hay hỏi nhà cậu ở đâu thì đừng trả lời, gọi bố mẹ ngay.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R09_1115",
        "text": "Không phải lỗi của mình. Không phải lỗi của bạn, kể cả khi bạn đã lỡ làm theo. Kể ra lúc nào cũng chưa muộn cả.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R09_610",
        "text": "Không phải lỗi của mình. Chuyện đó không phải lỗi của cậu đâu. Kể ra được là cậu can đảm lắm rồi.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R10_1115",
        "text": "Không gặp riêng bạn qua mạng. Đừng gặp riêng người chỉ quen qua mạng. Càng bị dặn giữ bí mật thì càng phải kể cho bố mẹ.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "rule_R10_610",
        "text": "Không gặp riêng bạn qua mạng. Người chỉ quen qua mạng mà rủ đi gặp thì đừng đi, kể cho bố mẹ nghe liền.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "rule_R11_1115",
        "text": "Có quyền từ chối gửi ảnh. Thích ai cũng không có nghĩa là phải gửi ảnh nhạy cảm. Ảnh gửi đi rồi là không lấy lại được nữa đâu.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      }
    ],
