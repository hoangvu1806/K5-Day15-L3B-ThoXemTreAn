      },
      {
        "id": "tactic_dan_bi_mat",
        "text": "Dặn giữ bí mật. Dặn đừng kể với bố mẹ. Bí mật kiểu này là bí mật xấu đấy. Cháu sẽ kể cho mẹ nghe.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "tactic_ep_bang_tinh_cam",
        "text": "Nếu thương thì phải làm. Lôi tình cảm ra ép mình làm điều mình không muốn. Thương thật thì không ép nhau đâu.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "tactic_gia_quen_bo_me",
        "text": "Tự nhận là người quen của bố mẹ. Người mình chưa gặp bao giờ mà nói quen bố mẹ mình. Để cháu gọi hỏi mẹ đã.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "tactic_giuc_gap",
        "text": "Giục đi thật nhanh. Cứ giục mình đi thật nhanh, không cho kịp hỏi ai cả. Cháu không vội đâu, để cháu hỏi bố mẹ đã.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "tactic_hua_vat_pham",
        "text": "Hứa tặng đồ trong game. Tặng vật phẩm, tặng skin để đổi lấy ảnh hay thông tin của mình. Thôi khỏi, cảm ơn.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      },
      {
        "id": "tactic_noi_me_gap_chuyen",
        "text": "Nói bố mẹ đang gặp chuyện. Bảo mẹ đang ở viện, bố bị sao đó, để mình hoảng mà đi theo. Để cháu gọi bố mẹ ngay bây giờ.",
        "role": "tin610",
        "age": "6-10",
        "per_name": false
      },
      {
        "id": "tactic_ru_gap_rieng",
        "text": "Rủ gặp riêng. Người chỉ quen qua mạng rủ gặp một mình, dặn đừng nói ai. Mình không đi đâu. Mình sẽ kể cho bố mẹ.",
        "role": "tin1115",
        "age": "11-15",
        "per_name": false
      }
    ],
